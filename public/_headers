# Security headers applied to every response by Cloudflare's static-asset
# server. Intentionally no Content-Security-Policy yet — Turnstile + the inline
# form script need a tested policy first (see SETUP.md / next steps).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Fingerprinted assets are immutable — cache them hard.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
