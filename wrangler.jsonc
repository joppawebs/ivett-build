{
  // Astro's Cloudflare adapter builds a Worker (the dynamic routes, e.g. the
  // contact form endpoint) plus a folder of static assets. The Worker serves
  // assets first and only runs code for non-static routes.
  "name": "ivett-build",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-06-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Binds the review site to its subdomain on deploy. This requires
  // joppawebs.co.uk to be a zone on the same Cloudflare account as the Worker;
  // if it isn't, delete this block and attach the domain from the dashboard
  // (Workers & Pages → the Worker → Settings → Domains & Routes).
  "routes": [
    {
      "pattern": "ivett.joppawebs.co.uk",
      "custom_domain": true
    }
  ],
  "observability": { "enabled": true }
}
