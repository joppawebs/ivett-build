---
/**
 * Privacy notice for this review site.
 *
 * Scoped to what this site actually does — it isn't a draft of Ivett's own
 * policy, and it shouldn't be mistaken for one.
 */
import Layout from '../layouts/Layout.astro';
import { AGENCY } from '../config';

const updated = '14 September 2026';
---
<Layout
  path="/privacy/"
  title="Privacy · Ivett Design and Build mockups"
  description="What this review site collects, and what happens to it."
  bodyClass="rv-page"
>
  <main>
    <p class="rv-kicker">Legal</p>
    <h1>Privacy</h1>
    <p class="rv-meta">Last updated: {updated}</p>

    <h2>What this site is</h2>
    <p>
      This is a private preview holding three homepage designs for Ivett Design and Build. It is
      operated by <a href={AGENCY.url}>{AGENCY.name}</a>, not by Ivett Design and Build, and it is
      not the live ivettbuild.com. It is excluded from search engines.
    </p>

    <h2>What it collects</h2>
    <p>
      Nothing, until you use one of the enquiry forms inside the mockups. Those forms take the
      name, email address and message you type. There are no analytics, no advertising and no
      cookies set by this site.
    </p>

    <h2>What happens to a submission</h2>
    <p>
      Submissions are checked by Cloudflare Turnstile (spam protection) and then sent by email
      through Postmark. The forms are real so you can see the stack working; on this preview no
      mail credentials are configured, so a submission is validated and then reported back as not
      set up. Nothing is stored in a database.
    </p>

    <h2>Hosting</h2>
    <p>
      The site is served by Cloudflare, which processes request data such as IP address in order to
      deliver the page and block abuse.
    </p>

    <h2>Getting in touch</h2>
    <p>
      Ask what's held, or ask for it to be deleted, at
      <a href={`mailto:${AGENCY.email}`}>{AGENCY.email}</a>.
    </p>
  </main>
  <footer class="rv-foot">
    Prepared by <a href={AGENCY.url}>{AGENCY.name}</a> · not the live ivettbuild.com
  </footer>
</Layout>

<style is:global>
  .rv-meta{font-size:13px;color:var(--rv-dim)}
</style>
