---
/**
 * Mockup 3 — "Slate".
 *
 * The furthest out of the three, to show the range: slate blue with orange kept
 * as the only accent, monospace for every figure, and an interactive build-up
 * panel — raft, ICF wall, hollowcore, steel, stairs, roof — driven by the
 * client's own section drawings. That panel is the thing a brochure can't do.
 */
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HeroVideo from '../components/HeroVideo.astro';
import ContactForm from '../components/ContactForm.astro';
import MockupSwitcher from '../components/MockupSwitcher.astro';
import { ABOUT_PARAGRAPHS, BUILD_UP, COMPANY, PROJECTS, SERVICES } from '../data/ivett';

const proof = [
  { figure: '94A', label: 'EPC as built · Twiga Lodge' },
  { figure: '0.9 t', label: 'CO₂/yr vs 6 t household avg' },
  { figure: '0.82', label: 'm³/(h·m²) @50 Pa · Charters Yard' },
  { figure: '20–23 °C', label: 'Winter, one radiator, −7 °C outside' },
  { figure: '18 mo', label: 'Loughborough University study' },
];

/** The wall is the layer worth opening on — it's where ICF explains itself. */
const DEFAULT_LAYER = 'walls';
---

<Layout
  path="/mockup-3/"
  title="Mockup 3 — Slate · Ivett Design and Build"
  description="Homepage direction 3 for Ivett Design and Build: slate blue with orange as the only accent, and an interactive build-up panel drawn from Ivett's own sections."
  fonts={['display', 'mono']}
  themeColor="#1C2530"
  bodyClass="m3"
>
  <a class="skip" href="#projects">Skip to content</a>
  <SiteHeader variant={3} desktopFrom={900}>
    <Fragment slot="actions">
      <a class="hd-phone" href={COMPANY.phoneHref}>{COMPANY.phone}</a>
      <a class="hd-cta" href="#contact">Enquire &rarr;</a>
    </Fragment>
  </SiteHeader>

  <main id="top">
    <section class="hero">
      <HeroVideo overlay="linear-gradient(180deg,rgba(28,37,48,0.4) 0%,rgba(28,37,48,0.55) 50%,rgba(28,37,48,0.92) 100%)" />
      <div class="hero-in">
        <p class="hero-tag">STRUCTURAL SHELL · ICF · STEEL · HOLLOWCORE · SIP</p>
        <h1>The structure and the thermal envelope, from one contractor.</h1>
        <p class="hero-lead">
          Ivett Design and Build delivers coordinated structural packages for high-performance
          buildings across the South of England, from insulated raft to roof panel.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-orange" href="#projects">Completed work</a>
          <a class="btn btn-outline" href="#systems">The package</a>
        </div>
      </div>
    </section>

    <section class="proof">
      <div class="proof-in">
        {proof.map((p) => (
          <div class="proof-cell">
            <span class="proof-fig">{p.figure}</span>
            <span class="proof-label">{p.label}</span>
          </div>
        ))}
      </div>
    </section>

    <section id="projects" class="work">
      <div class="rule">
        <h2>Completed work</h2>
        <span class="mono-note">02 CASE STUDIES · MORE IN PREPARATION</span>
      </div>
      <div class="work-grid">
        {PROJECTS.map((p) => (
          <article class="case">
            <a href="#projects">
              <Image
                src={p.image}
                alt={p.alt}
                width={1216}
                height={570}
                fit="cover"
                widths={[608, 1216]}
                sizes="(min-width: 900px) 46vw, 92vw"
              />
            </a>
            <div class="case-head">
              <div>
                <span class="mono-note">{p.kicker.toUpperCase()}</span>
                <h3>{p.name}</h3>
              </div>
              <span class="case-figs">{p.stack[0]}<br />{p.stack[1]}</span>
            </div>
            <p>{p.long}</p>
            <a class="case-link" href="#projects">Read the case study &rarr;</a>
          </article>
        ))}
      </div>
    </section>

    <section id="systems" class="package">
      <div class="package-in" data-buildup>
        <div class="package-side">
          <span class="mono-note">THE PACKAGE</span>
          <h2>Six systems, coordinated as one.</h2>
          <p class="package-intro">
            Each element is designed with the next so the shell goes up in sequence, with one point
            of responsibility. Select a layer to see the as-built detail from Twiga Lodge.
          </p>
          <div class="detail">
            {BUILD_UP.map((l) => (
              <figure class="detail-card" data-layer-detail={l.id} hidden={l.id !== DEFAULT_LAYER}>
                <Image src={l.image} alt={l.alt} width={800} widths={[400, 800]} sizes="(min-width: 900px) 42vw, 92vw" />
                <figcaption>
                  <span class="mono-note">{l.tag}</span>
                  <p>{l.desc}</p>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
        <div class="layers">
          {BUILD_UP.map((l) => (
            <button
              type="button"
              class="layer"
              data-layer={l.id}
              aria-pressed={l.id === DEFAULT_LAYER ? 'true' : 'false'}
            >
              <span class="layer-n">{l.n}</span>
              <span class="layer-text">
                <span class="layer-name">{l.name}</span>
                <span class="layer-spec">{l.spec}</span>
              </span>
              <span class="layer-value">{l.value}</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <section id="services" class="services">
      <div class="rule rule-stack">
        <span class="mono-note">PROFESSIONAL SERVICES</span>
        <h2>Before site.</h2>
      </div>
      <div class="svc-grid">
        {SERVICES.map((s) => (
          <article class="svc">
            <span class="mono-note svc-n">{s.n}</span>
            <h3>{s.name}</h3>
            <p>
              {s.short}
              {s.placeholder && <span class="todo"> {s.placeholder}</span>}
            </p>
          </article>
        ))}
      </div>
    </section>

    <section id="about" class="about">
      <div class="about-in">
        <div>
          <span class="mono-note about-kicker">ABOUT</span>
          <h2>Methods chosen on what performs in practice, not on habit.</h2>
          <dl class="about-facts">
            <dt>EST</dt><dd>{COMPANY.established}</dd>
            <dt>TYPE</dt><dd>Family-run contractor</dd>
            <dt>BASE</dt><dd>{COMPANY.base}</dd>
            <dt>COVER</dt><dd>£10m EL · £2m PL · £1m PI</dd>
          </dl>
        </div>
        <div class="about-body">
          {ABOUT_PARAGRAPHS.slice(1).map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <section id="contact" class="contact">
      <div class="contact-side">
        <h2>Discuss a project.</h2>
        <address>{COMPANY.addressLines[0]}<br />{COMPANY.addressLines[1]}</address>
        <div class="contact-links">
          <a href={COMPANY.phoneHref}>{COMPANY.phone}</a>
          <a href={`mailto:${COMPANY.salesEmail}`}>{COMPANY.salesEmail}</a>
          <a class="contact-alt" href={`mailto:${COMPANY.financeEmail}`}>{COMPANY.financeEmail}</a>
        </div>
      </div>
      <ContactForm
        nameLabel="Name"
        messageLabel="Project"
        messagePlaceholder="Location, type, stage, systems of interest"
        submitLabel="Send enquiry"
      />
    </section>
  </main>

  <SiteFooter variant={3} />
  <MockupSwitcher current={3} />
</Layout>

<script>
  import { initNav } from '../scripts/nav';
  initNav();

  /* The build-up panel: pick a layer, see the as-built detail for it. Every
     detail is in the HTML already, so this is a show/hide, not a fetch — and
     with JS off the default layer is simply the one on show. */
  const panel = document.querySelector('[data-buildup]');
  if (panel) {
    const buttons = panel.querySelectorAll<HTMLButtonElement>('[data-layer]');
    const details = panel.querySelectorAll<HTMLElement>('[data-layer-detail]');

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const id = button.dataset.layer;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        details.forEach((d) => (d.hidden = d.dataset.layerDetail !== id));
      });
    }
  }
</script>

<style is:global>
  .m3{
    font-family:var(--display);font-size:17px;color:#1C2530;background:#EEF0F2;
  }
  .m3 h1,.m3 h2,.m3 h3{font-weight:600;letter-spacing:-.03em;line-height:1}
  .m3 a:hover{color:var(--orange)}

  .m3 .skip{
    position:absolute;left:-9999px;top:8px;z-index:100;background:var(--orange);
    color:var(--slate);padding:12px 18px;font-weight:700;
  }
  .m3 .skip:focus{left:8px}

  .m3 .hd-phone{font-family:var(--mono);font-size:13px;color:#8FA0B3;white-space:nowrap}
  .m3 .hd-cta{color:var(--orange);font-weight:700;white-space:nowrap}

  .m3 section{max-width:1400px;margin:0 auto;padding:clamp(64px,8vw,120px) clamp(20px,4vw,56px)}
  .m3 .mono-note{font-family:var(--mono);font-size:12px;color:#5B6B7D;letter-spacing:.02em}
  .m3 .todo{color:#8FA0B3}
  .m3 .btn{display:inline-flex;align-items:center;padding:0 26px;min-height:54px;font-weight:600;font-size:16px}
  .m3 .btn-orange{background:var(--orange);color:var(--slate);font-weight:700}
  .m3 .btn-orange:hover{background:#EEF0F2;color:var(--slate)}
  .m3 .btn-outline{border:1.5px solid #EEF0F2;color:#EEF0F2}
  .m3 .btn-outline:hover{background:#EEF0F2;color:var(--slate)}
  .m3 .rule{
    display:flex;justify-content:space-between;align-items:baseline;gap:24px;
    flex-wrap:wrap;border-bottom:2px solid var(--slate);padding-bottom:16px;margin-bottom:40px;
  }
  .m3 .rule h2{font-size:clamp(32px,4vw,56px)}
  .m3 .rule-stack{display:block}
  .m3 .rule-stack h2{margin-top:8px}

  /* ---------- hero ---------- */
  .m3 .hero{
    position:relative;max-width:none;padding:0;min-height:min(88vh,860px);
    display:flex;align-items:flex-end;overflow:hidden;background:var(--slate);color:#EEF0F2;
  }
  .m3 .hero-in{
    position:relative;width:100%;max-width:1400px;margin:0 auto;
    padding:clamp(120px,14vw,200px) clamp(20px,4vw,56px) clamp(40px,5vw,64px);
    display:grid;gap:28px;justify-items:start;
  }
  .m3 .hero-tag{
    font-family:var(--mono);font-size:14px;font-weight:500;letter-spacing:.06em;
    justify-self:start;background:rgba(28,37,48,.75);padding:8px 12px;
    border-left:3px solid var(--orange);
  }
  .m3 .hero h1{font-size:clamp(34px,6vw,92px);line-height:.96;max-width:16ch;margin-top:-10px}
  .m3 .hero-lead{max-width:54ch;font-size:19px;color:#D5DBE2}
  .m3 .hero-ctas{display:flex;gap:12px;flex-wrap:wrap}

  /* ---------- proof strip ---------- */
  .m3 .proof{max-width:none;padding:0;background:var(--slate);color:#EEF0F2;border-top:1px solid #34435A}
  .m3 .proof-in{
    max-width:1400px;margin:0 auto;padding:0 clamp(20px,4vw,56px);
    display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
  }
  .m3 .proof-cell{padding:28px 24px;border-right:1px solid #34435A}
  .m3 .proof-cell:first-child{padding-left:0}
  .m3 .proof-cell:last-child{border-right:0;padding-right:0}
  .m3 .proof-fig{display:block;font-family:var(--mono);font-size:clamp(28px,2.6vw,38px);line-height:1}
  .m3 .proof-label{display:block;margin-top:8px;font-size:14px;color:#8FA0B3}

  /* ---------- work ---------- */
  .m3 .work-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:48px 64px}
  .m3 .case{display:grid;gap:20px;align-content:start}
  /* 32:15 — a quarter shorter than 16:10. Both photographs centre-crop to it
     cleanly: the building stays whole and only sky and ground are lost. Cut at
     build time, so the browser has nothing left to crop. */
  .m3 .case img{width:100%;aspect-ratio:32/15;object-fit:cover}
  .m3 .case-head{display:grid;grid-template-columns:1fr auto;gap:16px;align-items:start}
  .m3 .case-head h3{margin-top:6px;font-size:clamp(28px,2.6vw,38px)}
  .m3 .case-figs{font-family:var(--mono);font-size:13px;text-align:right;color:#5B6B7D;line-height:1.7}
  .m3 .case p{max-width:56ch}
  .m3 .case-link{font-weight:600;color:var(--orange)}

  /* ---------- the package ---------- */
  .m3 .package{max-width:none;padding:0;background:#fff}
  .m3 .package-in{
    max-width:1400px;margin:0 auto;padding:clamp(64px,8vw,120px) clamp(20px,4vw,56px);
    display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:48px 64px;align-items:start;
  }
  .m3 .package-side h2{margin-top:8px;font-size:clamp(32px,4vw,56px)}
  .m3 .package-intro{margin-top:20px;max-width:50ch}
  .m3 .detail{margin-top:32px;border:1px solid #D5DBE2;padding:20px;background:#EEF0F2}
  .m3 .detail-card{margin:0}
  .m3 .detail-card[hidden]{display:none}
  .m3 .detail-card img{width:100%;aspect-ratio:3/2;object-fit:contain;background:#fff}
  .m3 .detail-card figcaption{margin-top:14px}
  .m3 .detail-card figcaption p{margin-top:8px;font-size:15px}
  .m3 .layers{display:grid;gap:8px}
  .m3 .layer{
    display:grid;grid-template-columns:40px 1fr auto;gap:16px;align-items:center;
    text-align:left;width:100%;border:1.5px solid #D5DBE2;background:#fff;color:var(--slate);
    padding:18px 20px;min-height:72px;cursor:pointer;transition:border-color .15s ease,background .15s ease;
  }
  .m3 .layer:hover{border-color:var(--orange)}
  .m3 .layer[aria-pressed='true']{border-color:var(--orange);background:#FFF4E6}
  .m3 .layer-n{font-family:var(--mono);font-size:13px;color:#5B6B7D}
  .m3 .layer[aria-pressed='true'] .layer-n{color:var(--orange)}
  .m3 .layer-name{display:block;font-weight:600;font-size:22px;letter-spacing:-.02em;line-height:1.1}
  .m3 .layer-spec{display:block;font-size:14px;color:#5B6B7D;margin-top:4px}
  .m3 .layer-value{font-family:var(--mono);font-size:13px;white-space:nowrap}

  @media (min-width: 1000px){
    .m3 .package-side{position:sticky;top:24px}
  }

  /* ---------- services ---------- */
  .m3 .svc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:32px 48px}
  .m3 .svc-n{color:var(--orange)}
  .m3 .svc h3{margin:8px 0 10px;font-size:22px;letter-spacing:-.02em}
  .m3 .svc p{font-size:16px;color:#3D4B5B}

  /* ---------- about ---------- */
  .m3 .about{max-width:none;padding:0;background:var(--slate);color:#EEF0F2}
  .m3 .about-in{
    max-width:1400px;margin:0 auto;padding:clamp(64px,8vw,120px) clamp(20px,4vw,56px);
    display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:40px 64px;
  }
  .m3 .about-kicker{color:#8FA0B3}
  .m3 .about h2{margin-top:8px;font-size:clamp(30px,3.6vw,52px);line-height:1.02;max-width:18ch}
  .m3 .about-facts{
    margin-top:32px;display:grid;grid-template-columns:auto 1fr;gap:8px 24px;
    font-family:var(--mono);font-size:14px;
  }
  .m3 .about-facts dt{color:#8FA0B3}
  .m3 .about-body{display:grid;gap:18px;max-width:60ch;color:#D5DBE2;align-content:start}

  /* ---------- contact ---------- */
  .m3 .contact{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:48px 64px;align-items:start;
  }
  .m3 .contact-side{display:grid;gap:24px;align-content:start}
  .m3 .contact h2{font-size:clamp(32px,4vw,56px)}
  .m3 .contact address{font-style:normal;line-height:1.6;color:#3D4B5B}
  .m3 .contact-links{display:grid;gap:2px;font-family:var(--mono);font-size:16px}
  .m3 .contact-links a{min-height:44px;display:inline-flex;align-items:center}
  .m3 .contact-alt{color:#5B6B7D}

  /* ---------- the enquiry form ---------- */
  /* align-items:start stops a field being stretched to the height of the one
     beside it, and the label carries its own line-height rather than inheriting
     the body's 1.55 — a 12px mono cap-height in a 26px line box is what threw
     the label off the input it belongs to. */
  .m3 .f-form{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));
    gap:20px;align-content:start;align-items:start;align-self:start;
    background:#fff;padding:clamp(24px,3vw,32px);border:1px solid #D5DBE2;
  }
  .m3 .f-field{display:grid;gap:8px;align-content:start}
  .m3 .f-field-wide{grid-column:1/-1}
  .m3 .f-label{
    font-family:var(--mono);font-size:12px;line-height:1.2;letter-spacing:.06em;
    color:#5B6B7D;text-transform:uppercase;
  }
  .m3 .f-input,.m3 .f-textarea{
    width:100%;border:1px solid #D5DBE2;background:#fff;font-size:16px;line-height:1.4;
    border-radius:0;transition:border-color .15s ease,box-shadow .15s ease;
  }
  .m3 .f-input{padding:0 14px;min-height:48px}
  .m3 .f-textarea{padding:12px 14px;min-height:120px;resize:vertical}
  .m3 .f-input::placeholder,.m3 .f-textarea::placeholder{color:#8FA0B3}
  .m3 .f-input:hover,.m3 .f-textarea:hover{border-color:#B6C1CE}
  .m3 .f-input:focus,.m3 .f-textarea:focus{
    outline:none;border-color:var(--orange);box-shadow:0 0 0 3px rgba(241,135,0,.18);
  }
  .m3 .f-form .cf-turnstile{margin-top:4px}
  .m3 .f-submit{
    justify-self:start;grid-column:1/-1;min-height:50px;padding:0 28px;
    background:var(--orange);color:var(--slate);border:0;font-size:16px;font-weight:700;
    cursor:pointer;transition:background .15s ease,color .15s ease;
  }
  .m3 .f-submit:hover{background:var(--slate);color:#fff}

  @media (max-width: 700px){
    .m3 .proof-cell{padding:22px 0;border-right:0;border-bottom:1px solid #34435A}
    .m3 .proof-cell:last-child{border-bottom:0}
    .m3 .f-submit{justify-self:stretch;text-align:center}
  }
</style>
