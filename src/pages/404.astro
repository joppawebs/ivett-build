---
/**
 * Not found — in the review chrome, not in any of the three designs.
 * A visitor who mistypes a URL should land somewhere that says plainly what
 * this site is and offers the three directions.
 */
import Layout from '../layouts/Layout.astro';
import { MOCKUPS, AGENCY } from '../config';
---
<Layout
  path="/404/"
  title="Page not found · Ivett Design and Build mockups"
  description="That page isn't part of the mockup set."
  bodyClass="rv-page"
>
  <main>
    <p class="rv-kicker">404</p>
    <h1>That page isn't part of the mockup set.</h1>
    <p>
      This site holds three homepage directions for Ivett Design and Build — nothing else is built
      yet. Links inside the mockups that point at inner pages (case studies, system pages, the
      insurance page) are deliberately inert: they'd be built for real, but they aren't part of a
      homepage comparison.
    </p>

    <h2>The three directions</h2>
    <ul class="rv-list">
      {MOCKUPS.map((m) => (
        <li>
          <a href={m.path}>{m.n}. {m.name}</a> — {m.blurb}
        </li>
      ))}
    </ul>

    <div class="rv-actions">
      <a class="rv-btn" href="/">Start at direction 1</a>
    </div>
  </main>
  <footer class="rv-foot">
    Prepared by <a href={AGENCY.url}>{AGENCY.name}</a> · not the live ivettbuild.com
  </footer>
</Layout>

<style is:global>
  .rv-list{margin-top:12px;padding-left:20px;display:grid;gap:8px;max-width:62ch}
  .rv-list li{padding-left:2px}
</style>
