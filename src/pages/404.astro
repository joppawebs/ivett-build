---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
---
<Layout
  path="/404/"
  title={`Page not found - ${SITE.name}`}
  description="The page you were looking for couldn't be found."
>
  <meta slot="head" name="robots" content="noindex" />

  <Header />
  <section class="notfound">
    <div class="wrap notfound-card">
      <span class="eyebrow" style="justify-content:center">Error 404</span>
      <h1>This page wandered off.</h1>
      <p>The page you're looking for doesn't exist, or it may have moved. Let's get you back on track.</p>
      <div class="notfound-cta">
        <a class="btn btn-primary" href="/">Back to home</a>
        <a class="btn btn-ghost" href="/work/">See our work</a>
        <a class="btn btn-ghost" href="/#contact">Get in touch</a>
      </div>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .notfound{min-height:60vh;display:flex;align-items:center;padding:80px 0}
  .notfound-card{max-width:580px;text-align:center}
  .notfound h1{font-family:var(--display);font-size:clamp(2.1rem,4.4vw,3rem);font-weight:800;margin:.3em 0 .35em}
  .notfound p{color:var(--ink-mid);font-size:1.08rem;max-width:480px;margin:0 auto}
  .notfound-cta{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:36px}
</style>
