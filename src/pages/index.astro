---
/**
 * Mockup 1 — "Evolution".
 *
 * Deliberately close to the client's current site: white header, the orange
 * logo block, orange buttons, the same section order. What changes is
 * underneath — a real type scale, the performance figures near the top rather
 * than the bottom, six honest system cards, 44px tap targets, and an insurance
 * strip that can actually be reached.
 */
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HeroVideo from '../components/HeroVideo.astro';
import ContactForm from '../components/ContactForm.astro';
import MockupSwitcher from '../components/MockupSwitcher.astro';
import scanTimber from '../assets/scan-timber.jpg';
import scanIcf from '../assets/scan-icf.jpg';
import {
  ABOUT_PARAGRAPHS,
  COMPANY,
  INSURANCE,
  PROJECTS,
  SERVICES,
  SYSTEMS,
  SYSTEMS_INTRO,
} from '../data/ivett';

const heroProof = [
  { figure: '94A', label: 'EPC rating, Twiga Lodge' },
  { figure: '0.82', label: 'air permeability, Charters Yard' },
  { figure: '£10m', label: "employers' liability" },
  { figure: '2018', label: 'established, Farnham' },
];

const evidence = [
  { figure: '94A', label: 'EPC as built' },
  { figure: '0.11', label: 'Wall U-value W/m²K' },
  { figure: '0.9 t', label: 'CO₂ per year' },
];

// Three columns from 1000px, two from 640px, one below — matches .grid-3.
const cardSizes =
  '(min-width: 1320px) 400px, (min-width: 1000px) 32vw, (min-width: 640px) 46vw, 92vw';
---

<Layout
  path="/"
  title="Mockup 1 — Evolution · Ivett Design and Build"
  description="Homepage direction 1 for Ivett Design and Build: closest to the current site, with the structure, type scale and performance figures rebuilt underneath."
  fonts={['sans']}
  themeColor="#ffffff"
  bodyClass="m1"
>
  <a class="skip" href="#about">Skip to content</a>
  <SiteHeader variant={1} desktopFrom={960}>
    <Fragment slot="actions">
      <a class="hd-phone" href={COMPANY.phoneHref}>{COMPANY.phone}</a>
      <a class="hd-cta" href="#contact">Contact us</a>
    </Fragment>
  </SiteHeader>

  <main id="top">
    <section class="hero">
      <HeroVideo overlay="linear-gradient(180deg,rgba(30,29,29,0.35) 0%,rgba(30,29,29,0.55) 60%,rgba(30,29,29,0.75) 100%)" />
      <div class="hero-in">
        <p class="hero-kicker">ICF contractor · Surrey and the South of England</p>
        <h1>Structural building specialists for high-performance homes and workplaces.</h1>
        <p class="hero-lead">
          Insulated foundations, ICF walls, structural steel, floors, stairs and roofs, designed
          and installed as one coordinated package by a family-run contractor established in 2018.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-orange" href="#projects">View our projects</a>
          <a class="btn btn-outline" href="#contact">Get in touch</a>
        </div>
      </div>
      <div class="hero-proof">
        <div class="hero-proof-in">
          {heroProof.map((p) => (
            <span><strong>{p.figure}</strong> {p.label}</span>
          ))}
        </div>
      </div>
    </section>

    <section id="about" class="about">
      <div class="about-lead">
        <p class="eyebrow">About</p>
        <h2>A family-run structural contractor with a fabric-first approach.</h2>
        <dl class="about-facts">
          <div><dt>Established</dt><dd>{COMPANY.established}</dd></div>
          <div><dt>Based</dt><dd>Farnham</dd></div>
          <div><dt>Working across</dt><dd>The South</dd></div>
        </dl>
      </div>
      <div class="about-body">
        {ABOUT_PARAGRAPHS.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section id="services" class="services">
      <div class="services-in">
        <p class="eyebrow">Professional services</p>
        <h2 class="services-h">Design, coordination and management before anything reaches site.</h2>
        <div class="grid-3">
          {SERVICES.map((s) => (
            <article class="svc-card">
              <Image
                src={s.image}
                alt={s.alt}
                width={832}
                height={364}
                fit="cover"
                position={s.crop}
                widths={[416, 832]}
                sizes={cardSizes}
              />
              <h3>{s.name}</h3>
              <p>
                {s.long}
                {s.placeholder && <span class="todo"> {s.placeholder}</span>}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="systems" class="systems">
      <div class="systems-head">
        <div>
          <p class="eyebrow">Structural systems</p>
          <h2>Foundation to roof, as one buildable package.</h2>
        </div>
        <p class="systems-intro">{SYSTEMS_INTRO}</p>
      </div>
      <div class="grid-3">
        {SYSTEMS.map((s) => (
          <a class="sys-card" href="#systems">
            <Image
              src={s.image}
              alt={s.alt}
              width={840}
              height={560}
              fit="cover"
              position={s.crop}
              widths={[420, 840]}
              sizes={cardSizes}
            />
            <div class="sys-body">
              <h3>{s.name}</h3>
              <p>{s.long}</p>
              <span class="sys-more">Learn more →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section id="projects" class="projects">
      <div class="projects-in">
        <div class="projects-head">
          <div>
            <p class="eyebrow eyebrow-lt">Projects</p>
            <h2>Completed work</h2>
          </div>
          <p class="projects-note">Two full case studies. Further studies in preparation.</p>
        </div>
        <div class="grid-2">
          {PROJECTS.map((p) => (
            <a class="proj" href="#projects">
              <Image
                src={p.image}
                alt={p.alt}
                width={1280}
                widths={[640, 1280]}
                sizes="(min-width: 900px) 46vw, 92vw"
              />
              <span class="proj-scrim"></span>
              <div class="proj-text">
                <p class="proj-kicker">{p.kicker}</p>
                <h3>{p.name}</h3>
                <p class="proj-summary">{p.summary}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="evidence">
      <div>
        <p class="eyebrow">Independently monitored</p>
        <h2>Eighteen months of measured performance.</h2>
        <p class="evidence-body">
          Twiga Lodge was monitored in occupation by Loughborough University's School of Civil and
          Building Engineering. The house holds 20–23 °C through winter on a single radiator, with
          an estimated 0.9 tonnes of CO₂ a year against a six-tonne household average.
        </p>
        <div class="evidence-figs">
          {evidence.map((e) => (
            <div><span class="fig">{e.figure}</span><span class="fig-label">{e.label}</span></div>
          ))}
        </div>
      </div>
      <figure class="scan" data-scan>
        <div class="scan-stage">
          <Image
            class="scan-img is-on"
            data-scan-slide
            src={scanTimber}
            alt="Thermal imaging scan of a timber frame house, showing heat escaping at the junctions"
            width={1000}
            widths={[500, 1000]}
            sizes="(min-width: 900px) 46vw, 92vw"
          />
          <Image
            class="scan-img"
            data-scan-slide
            src={scanIcf}
            alt="Thermal imaging scan of an ICF house, showing an even envelope with minimal heat loss"
            width={1000}
            widths={[500, 1000]}
            sizes="(min-width: 900px) 46vw, 92vw"
          />
        </div>
        <figcaption>
          <span data-scan-caption>Timber frame house, thermal scan</span>
          <span class="scan-dots">
            <button type="button" data-scan-dot class="is-on" aria-label="Timber frame scan"></button>
            <button type="button" data-scan-dot aria-label="ICF scan"></button>
          </span>
        </figcaption>
      </figure>
    </section>

    <section class="creds">
      <div class="creds-in">
        {INSURANCE.map((i) => (
          <div><span class="creds-label">{i.label}</span><span class="creds-value">{i.value}</span></div>
        ))}
        <div><span class="creds-label">Company no.</span><span class="creds-value">{COMPANY.companyNo}</span></div>
        <div>
          <span class="creds-label">Follow us</span>
          <a class="creds-value creds-link" href={COMPANY.instagram}>@ivettbuild</a>
        </div>
      </div>
    </section>

    <section id="contact" class="contact">
      <div class="contact-side">
        <div>
          <p class="eyebrow">Contact</p>
          <h2>Got a project in mind?</h2>
        </div>
        <address>{COMPANY.addressLines[0]}<br />{COMPANY.addressLines[1]}</address>
        <dl class="contact-list">
          <div><dt>Tel</dt><dd><a href={COMPANY.phoneHref}>{COMPANY.phone}</a></dd></div>
          <div><dt>Sales</dt><dd><a href={`mailto:${COMPANY.salesEmail}`}>{COMPANY.salesEmail}</a></dd></div>
          <div><dt>Finance</dt><dd><a href={`mailto:${COMPANY.financeEmail}`}>{COMPANY.financeEmail}</a></dd></div>
        </dl>
      </div>
      <ContactForm splitName submitLabel="Submit" messageLabel="Message" />
    </section>
  </main>

  <SiteFooter variant={1} />
  <MockupSwitcher current={1} />
</Layout>

<script>
  import { initNav } from '../scripts/nav';
  initNav();

  /* The thermal-scan comparison: two frames, cross-faded. Auto-advances until
     the visitor takes over, and holds still under prefers-reduced-motion. */
  const scan = document.querySelector('[data-scan]');
  if (scan) {
    const slides = scan.querySelectorAll<HTMLElement>('[data-scan-slide]');
    const dots = scan.querySelectorAll<HTMLButtonElement>('[data-scan-dot]');
    const caption = scan.querySelector<HTMLElement>('[data-scan-caption]');
    const captions = ['Timber frame house, thermal scan', 'ICF house, thermal scan'];
    let index = 0;
    let timer = 0;

    const show = (next: number) => {
      index = next % slides.length;
      slides.forEach((slide, i) => slide.classList.toggle('is-on', i === index));
      dots.forEach((dot, i) => dot.classList.toggle('is-on', i === index));
      if (caption) caption.textContent = captions[index] ?? '';
    };

    const stop = () => window.clearInterval(timer);

    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => { stop(); show(i); })
    );

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      timer = window.setInterval(() => show(index + 1), 4000);
    }
  }
</script>

<style is:global>
  .m1{
    font-family:var(--sans);font-size:17px;color:var(--char);background:#fff;
  }
  .m1 h1,.m1 h2,.m1 h3{letter-spacing:-.02em;line-height:1.1;font-weight:700}
  .m1 a:hover{color:var(--orange)}

  .m1 .skip{
    position:absolute;left:-9999px;top:8px;z-index:100;background:var(--orange);
    color:#fff;padding:12px 18px;font-weight:600;
  }
  .m1 .skip:focus{left:8px}

  /* header actions (slotted into SiteHeader) */
  .m1 .hd-phone{font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;font-size:15px}
  .m1 .hd-cta{
    background:var(--orange);color:#fff;padding:0 20px;min-height:44px;font-size:15px;
    display:inline-flex;align-items:center;font-weight:600;border-radius:4px;white-space:nowrap;
  }
  .m1 .hd-cta:hover{background:var(--char);color:#fff}

  /* ---------- shared bits ---------- */
  .m1 .eyebrow{
    font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;
    color:var(--orange);margin-bottom:12px;
  }
  .m1 .eyebrow-lt{color:var(--orange-lt)}
  .m1 .btn{
    display:inline-flex;align-items:center;padding:0 26px;min-height:52px;
    font-weight:600;font-size:16px;border-radius:4px;
  }
  .m1 .btn-orange{background:var(--orange);color:#fff}
  .m1 .btn-orange:hover{background:#fff;color:var(--char)}
  .m1 .btn-outline{border:2px solid #fff;color:#fff}
  .m1 .btn-outline:hover{background:#fff;color:var(--char)}
  .m1 section{max-width:1320px;margin:0 auto;padding:clamp(56px,7vw,104px) clamp(20px,4vw,48px)}
  .m1 .grid-3{display:grid;grid-template-columns:1fr;gap:24px}
  @media (min-width: 640px){ .m1 .grid-3{grid-template-columns:repeat(2,1fr)} }
  @media (min-width: 1000px){ .m1 .grid-3{grid-template-columns:repeat(3,1fr)} }
  .m1 .grid-2{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px}

  /* ---------- hero ---------- */
  /* Two rows: the copy takes the free space and centres in it, the proof strip
     takes what it needs underneath. The strip used to be absolutely positioned
     against the bottom, which worked until it wrapped to four lines on a phone
     and rode up over the buttons. In flow it can't overlap at any width, and on
     a wide screen it still reads as pinned to the foot of the video. */
  .m1 .hero{
    position:relative;max-width:none;padding:0;min-height:min(92vh,880px);
    display:grid;grid-template-rows:1fr auto;
    background:var(--char);color:#fff;overflow:hidden;
  }
  .m1 .hero-in{
    position:relative;align-self:center;width:100%;max-width:1320px;margin:0 auto;
    padding:clamp(88px,12vw,150px) clamp(20px,4vw,48px) clamp(40px,6vw,72px);
  }
  .m1 .hero-kicker{
    font-size:14px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;
    color:var(--orange-lt);margin-bottom:20px;
  }
  .m1 .hero h1{font-size:clamp(34px,5.6vw,76px);line-height:1.02;max-width:18ch}
  .m1 .hero-lead{margin-top:24px;max-width:56ch;font-size:clamp(17px,1.4vw,21px);color:#F2F0ED}
  .m1 .hero-ctas{display:flex;gap:14px;flex-wrap:wrap;margin-top:36px}
  .m1 .hero-proof{
    position:relative;background:rgba(30,29,29,.6);backdrop-filter:blur(6px);
    border-top:1px solid rgba(255,255,255,.14);
  }
  .m1 .hero-proof-in{
    max-width:1320px;margin:0 auto;padding:16px clamp(20px,4vw,48px);
    display:flex;flex-wrap:wrap;gap:8px 40px;font-size:14px;font-variant-numeric:tabular-nums;
  }
  .m1 .hero-proof strong{color:var(--orange-lt);font-size:18px;margin-right:6px}

  /* ---------- about ---------- */
  .m1 .about{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:40px 80px;align-items:start}
  .m1 .about h2{font-size:clamp(28px,3.4vw,46px)}
  .m1 .about-facts{
    margin-top:32px;display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));
    gap:20px;font-variant-numeric:tabular-nums;
  }
  .m1 .about-facts dt{font-size:13px;color:var(--rv-dim)}
  .m1 .about-facts dd{margin-top:2px;font-size:26px;font-weight:700}
  .m1 .about-body{display:grid;gap:18px;max-width:62ch}

  /* ---------- services ---------- */
  .m1 .services{max-width:none;padding:0;background:#F7F7F7}
  .m1 .services-in{max-width:1320px;margin:0 auto;padding:clamp(56px,7vw,104px) clamp(20px,4vw,48px)}
  .m1 .services-h{font-size:clamp(28px,3.4vw,46px);max-width:24ch;margin-bottom:40px}
  .m1 .svc-card{background:#fff;padding:32px;border-top:4px solid var(--orange)}
  /* 16:7 — a third shorter than 16:10, cropped to a band at build time so the
     browser has nothing left to cut. Each image's anchor is set in data. */
  .m1 .svc-card img{width:100%;aspect-ratio:16/7;object-fit:cover;margin-bottom:24px}
  .m1 .svc-card h3{font-size:22px;margin-bottom:10px}
  .m1 .svc-card p{font-size:16px}
  .m1 .todo{color:var(--rv-dim)}

  /* ---------- systems ---------- */
  .m1 .systems-head{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:24px 80px;align-items:end;margin-bottom:40px;
  }
  .m1 .systems-head h2{font-size:clamp(28px,3.4vw,46px)}
  .m1 .systems-intro{max-width:56ch}
  .m1 .sys-card{display:block;border:1px solid #E6E4E1;background:#fff;transition:border-color .15s ease}
  .m1 .sys-card:hover{border-color:var(--orange);color:inherit}
  .m1 .sys-card img{width:100%;aspect-ratio:3/2;object-fit:cover}
  @media (max-width: 640px){
    .m1 .sys-card img{aspect-ratio:2/1}
  }
  .m1 .sys-body{padding:24px}
  .m1 .sys-body h3{font-size:21px;margin-bottom:8px}
  .m1 .sys-body p{font-size:15px;color:#5A5857;margin-bottom:16px}
  .m1 .sys-more{font-size:14px;font-weight:600;color:var(--orange)}

  /* ---------- projects ---------- */
  .m1 .projects{max-width:none;padding:0;background:var(--char);color:#fff}
  .m1 .projects-in{max-width:1320px;margin:0 auto;padding:clamp(56px,7vw,104px) clamp(20px,4vw,48px)}
  .m1 .projects-head{
    display:flex;justify-content:space-between;align-items:end;gap:24px;
    flex-wrap:wrap;margin-bottom:40px;
  }
  .m1 .projects-head h2{font-size:clamp(28px,3.4vw,46px)}
  .m1 .projects-note{color:#C9C7C4;font-size:15px}
  .m1 .proj{position:relative;display:block;aspect-ratio:4/3;overflow:hidden;color:#fff}
  .m1 .proj:hover{color:#fff}
  .m1 .proj img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .5s ease}
  .m1 .proj:hover img{transform:scale(1.04)}
  .m1 .proj-scrim{
    position:absolute;inset:0;
    background:linear-gradient(180deg,rgba(30,29,29,0) 40%,rgba(30,29,29,.9) 100%);
  }
  .m1 .proj-text{position:absolute;left:28px;right:28px;bottom:28px}
  .m1 .proj-kicker{font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--orange-lt);margin-bottom:6px}
  .m1 .proj h3{font-size:28px}
  .m1 .proj-summary{margin-top:6px;font-size:15px;color:#E6E3DF}

  /* ---------- evidence ---------- */
  .m1 .evidence{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:40px 80px;align-items:center}
  .m1 .evidence h2{font-size:clamp(28px,3.4vw,46px)}
  .m1 .evidence-body{margin-top:20px;max-width:56ch}
  .m1 .evidence-figs{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));
    gap:20px;margin-top:32px;font-variant-numeric:tabular-nums;
  }
  .m1 .evidence-figs>div{border-top:3px solid var(--orange);padding-top:12px}
  .m1 .fig{display:block;font-size:32px;font-weight:700;line-height:1}
  .m1 .fig-label{display:block;font-size:14px;color:var(--rv-dim);margin-top:4px}
  .m1 .scan{margin:0}
  .m1 .scan-stage{position:relative;width:100%;aspect-ratio:500/379;background:#F7F7F7;overflow:hidden}
  .m1 .scan-img{
    position:absolute;inset:0;width:100%;height:100%;object-fit:contain;
    opacity:0;transition:opacity .8s ease;
  }
  .m1 .scan-img.is-on{opacity:1}
  .m1 .scan figcaption{
    display:flex;justify-content:space-between;align-items:center;gap:16px;
    font-size:13px;color:var(--rv-dim);margin-top:10px;
  }
  .m1 .scan-dots{display:flex;gap:6px}
  .m1 .scan-dots button{width:32px;height:12px;padding:0;border:0;background:none;cursor:pointer}
  .m1 .scan-dots button::after{content:'';display:block;height:6px;margin-top:3px;background:var(--rv-line)}
  .m1 .scan-dots button.is-on::after{background:var(--orange)}

  /* ---------- credentials ---------- */
  .m1 .creds{max-width:none;padding:0;background:#F7F7F7;border-block:1px solid #E6E4E1}
  .m1 .creds-in{
    max-width:1320px;margin:0 auto;padding:clamp(32px,4vw,56px) clamp(20px,4vw,48px);
    display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:24px 40px;
    font-variant-numeric:tabular-nums;
  }
  .m1 .creds-label{display:block;font-size:13px;color:var(--rv-dim)}
  .m1 .creds-value{display:block;font-size:24px;font-weight:700}
  .m1 .creds-link{color:var(--orange)}

  /* ---------- contact ---------- */
  .m1 .contact{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:40px 80px;align-items:start;
  }
  .m1 .contact h2{font-size:clamp(28px,3.4vw,46px)}
  .m1 .contact-side{display:grid;gap:24px;align-content:start}
  .m1 .contact address{font-style:normal;line-height:1.6}
  .m1 .contact-list{display:grid;gap:4px;font-variant-numeric:tabular-nums}
  .m1 .contact-list>div{display:flex;gap:16px;align-items:center}
  .m1 .contact-list dt{width:80px;color:var(--rv-dim);font-size:14px}
  .m1 .contact-list dd a{min-height:44px;display:inline-flex;align-items:center;font-weight:600}

  /* ---------- the enquiry form ---------- */
  /* Two columns for the name row, full width for everything after it. The card
     hugs its content rather than stretching to the height of the column beside
     it, which otherwise leaves a slab of empty grey under the button. The
     orange top rule matches the service cards further up the page. */
  .m1 .f-form{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
    gap:20px;align-content:start;align-self:start;
    background:#F7F7F7;border-top:4px solid var(--orange);
    padding:clamp(24px,3vw,32px);
  }
  .m1 .f-field{display:grid;gap:7px;align-content:start}
  .m1 .f-field-wide{grid-column:1/-1}
  .m1 .f-label{font-size:14px;font-weight:600;color:var(--char)}
  .m1 .f-input,.m1 .f-textarea{
    width:100%;border:1px solid var(--rv-line);background:#fff;
    font-size:16px;font-weight:400;border-radius:4px;
    transition:border-color .15s ease,box-shadow .15s ease;
  }
  .m1 .f-input{padding:0 14px;min-height:48px}
  .m1 .f-textarea{padding:12px 14px;min-height:120px;resize:vertical;line-height:1.5}
  .m1 .f-input:hover,.m1 .f-textarea:hover{border-color:#BFBCB8}
  .m1 .f-input:focus,.m1 .f-textarea:focus{
