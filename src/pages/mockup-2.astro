---
/**
 * Mockup 2 — "Bold orange".
 *
 * The same palette as the current site, used with more confidence: a near-black
 * ground, a solid orange band for the performance figures, display type at
 * scale, and the systems as a numbered list rather than a grid of cards.
 */
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HeroVideo from '../components/HeroVideo.astro';
import ContactForm from '../components/ContactForm.astro';
import MockupSwitcher from '../components/MockupSwitcher.astro';
import cyStair from '../assets/cy-stair.jpg';
import { COMPANY, INSURANCE, PROJECTS, SERVICES, SYSTEMS } from '../data/ivett';

const proof = [
  { figure: '94A', label: 'EPC as built, Twiga Lodge' },
  { figure: '0.9t', label: 'CO₂ a year, against a 6 t household average' },
  { figure: '0.82', label: 'Air permeability m³/(h·m²), Charters Yard' },
  { figure: '18', unit: 'months', label: 'Loughborough University monitoring study' },
];
---

<Layout
  path="/mockup-2/"
  title="Mockup 2 — Bold orange · Ivett Design and Build"
  description="Homepage direction 2 for Ivett Design and Build: the same orange, used with more confidence on a near-black ground."
  fonts={['display']}
  themeColor="#1E1D1D"
  bodyClass="m2"
>
  <a class="skip" href="#projects">Skip to content</a>
  <SiteHeader variant={2} desktopFrom={900}>
    <Fragment slot="actions">
      <a class="hd-cta" href="#contact">Start a project &rarr;</a>
    </Fragment>
  </SiteHeader>

  <main id="top">
    <section class="hero">
      <HeroVideo overlay="linear-gradient(180deg,rgba(30,29,29,0.5) 0%,rgba(30,29,29,0.3) 40%,rgba(30,29,29,0.85) 100%)" />
      <div class="hero-in">
        <h1>Built to <span class="hero-accent">perform.</span></h1>
        <div class="hero-foot">
          <p class="hero-lead">
            ICF and structural building packages for the South of England. Foundations, walls,
            steel, floors, stairs and roofs from one family-run contractor.
          </p>
          <div class="hero-ctas">
            <a class="btn btn-orange" href="#projects">See the work</a>
            <a class="btn btn-outline" href="#contact">Enquire</a>
          </div>
        </div>
      </div>
    </section>

    <section class="proof">
      <div class="proof-in">
        {proof.map((p) => (
          <div>
            <span class="proof-fig">{p.figure}{p.unit && <span class="proof-unit">{p.unit}</span>}</span>
            <span class="proof-label">{p.label}</span>
          </div>
        ))}
      </div>
    </section>

    <section id="projects" class="projects">
      <div class="projects-head">
        <h2>Projects</h2>
        <p>Two completed case studies, with further studies in preparation.</p>
      </div>
      <div class="projects-grid">
        {PROJECTS.map((p) => (
          <a class="proj" href="#projects">
            <Image
              src={p.image}
              alt={p.alt}
              width={1000}
              widths={[500, 1000]}
              sizes="(min-width: 900px) 48vw, 94vw"
            />
            <span class="proj-scrim"></span>
            <div class="proj-text">
              <span class="proj-kicker">{p.kicker}</span>
              <h3>{p.name}</h3>
              <p>{p.short}</p>
              <span class="proj-figs">
                {p.figures.map((f, i) => (
                  <>{i > 0 && <span aria-hidden="true">·</span>}<span>{f}</span></>
                ))}
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section id="systems" class="systems">
      <div class="systems-head">
        <h2>Six systems.<br />One package.</h2>
        <p>
          Foundations, walls, floors, steel and roof structures combined into a complete, buildable
          solution. Insulation type, structural configuration and external finish are chosen to suit
          the performance requirement and the design intent.
        </p>
      </div>
      <div class="sys-list">
        {SYSTEMS.map((s) => (
          <a class="sys-row" href="#systems">
            <span class="sys-n">{s.n}</span>
            <span class="sys-name">{s.name}</span>
            <span class="sys-desc">{s.short}</span>
            <Image
              class="sys-thumb"
              src={s.image}
              alt={s.alt}
              width={240}
              height={160}
              fit="cover"
              position={s.crop}
              widths={[120, 240]}
              sizes="120px"
            />
          </a>
        ))}
      </div>
    </section>

    <section id="services" class="services">
      <div class="services-in">
        <h2>Before site.</h2>
        <div class="svc-grid">
          {SERVICES.map((s) => (
            <article class="svc-card">
              <span class="svc-n">{s.n}</span>
              <h3>{s.name}</h3>
              <p>
                {s.short}
                {s.placeholder && <span class="todo"> {s.placeholder}</span>}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="about" class="about">
      <Image class="about-bg" src={cyStair} alt="" width={1600} widths={[900, 1600]} sizes="100vw" />
      <span class="about-scrim"></span>
      <div class="about-in">
        <h2>Family-run since <span class="hero-accent">2018.</span> Fabric first, always.</h2>
        <div class="about-body">
          <p>
            Ivett Design and Build is a family-run contractor based in Farnham, Surrey, delivering
            well-considered structural solutions for residential and commercial projects. Our
            approach is grounded in practical site experience, with a strong emphasis on
            buildability, coordination and long-term performance.
          </p>
          <p>
            Having worked across design, supply, manufacture and construction, we bring a broad
            understanding of different materials and systems, selecting construction methods on what
            will perform best in practice rather than following a fixed formula.
          </p>
          <div class="about-creds">
            {INSURANCE.map((i) => <span>{i.short}</span>)}
            <span>Company no. {COMPANY.companyNo}</span>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="contact">
      <div class="contact-in">
      <div class="contact-side">
        <h2>Start a project.</h2>
        <address>{COMPANY.addressLines[0]}<br />{COMPANY.addressLines[1]}</address>
        <div class="contact-links">
          <a href={COMPANY.phoneHref}>{COMPANY.phone}</a>
          <a href={`mailto:${COMPANY.salesEmail}`}>{COMPANY.salesEmail}</a>
          <a class="contact-alt" href={`mailto:${COMPANY.financeEmail}`}>
            {COMPANY.financeEmail} (finance)
          </a>
        </div>
      </div>
      <ContactForm
        messageLabel="Project"
        messagePlaceholder="Location, type and stage"
        submitLabel="Send enquiry"
        turnstileTheme="light"
      />
      </div>
    </section>
  </main>

  <SiteFooter variant={2} />
  <MockupSwitcher current={2} />
</Layout>

<script>
  import { initNav } from '../scripts/nav';
  initNav();
</script>

<style is:global>
  .m2{
    font-family:var(--display);font-size:17px;color:#F2F0ED;background:var(--char-deep);
  }
  .m2 h1,.m2 h2,.m2 h3{line-height:.95;letter-spacing:-.04em;font-weight:800}
  .m2 a:hover{color:var(--orange)}

  .m2 .skip{
    position:absolute;left:-9999px;top:8px;z-index:100;background:var(--orange);
    color:var(--char-deep);padding:12px 18px;font-weight:700;
  }
  .m2 .skip:focus{left:8px}

  .m2 .hd-cta{color:var(--orange);font-weight:700;white-space:nowrap}
  .m2 .hd-cta:hover{color:#fff}

  .m2 section{max-width:1400px;margin:0 auto;padding:clamp(64px,8vw,128px) clamp(20px,4vw,56px)}
  .m2 .btn{
    display:inline-flex;align-items:center;padding:0 28px;min-height:56px;
    font-weight:700;font-size:16px;
  }
  .m2 .btn-orange{background:var(--orange);color:var(--char-deep)}
  .m2 .btn-orange:hover{background:#fff;color:var(--char-deep)}
  .m2 .btn-outline{border:2px solid #fff;color:#fff}
  .m2 .btn-outline:hover{background:#fff;color:var(--char-deep)}
  .m2 .todo{color:#8A8886}

  /* ---------- hero ---------- */
  .m2 .hero{
    position:relative;max-width:none;padding:0;min-height:min(100vh,1000px);
    display:flex;align-items:flex-end;overflow:hidden;background:var(--char-deep);color:#fff;
  }
  .m2 .hero-in{
    position:relative;width:100%;max-width:1400px;margin:0 auto;
    padding:180px clamp(20px,4vw,56px) clamp(32px,4vw,56px);
  }
  .m2 .hero h1{font-size:clamp(52px,10vw,168px);line-height:.9;max-width:10ch}
  .m2 .hero-accent{color:var(--orange)}
  .m2 .hero-foot{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:24px 64px;align-items:end;margin-top:40px;
  }
  .m2 .hero-lead{max-width:48ch;font-size:clamp(18px,1.5vw,22px);line-height:1.4}
  .m2 .hero-ctas{display:flex;gap:12px;flex-wrap:wrap}
  /* On desktop the lead and the buttons share a row — push the buttons out to
     the right edge so they sit against the margin rather than mid-page. */
  @media (min-width: 900px){
    .m2 .hero-ctas{justify-content:flex-end}
  }

  /* ---------- proof strip ---------- */
  .m2 .proof{max-width:none;padding:0;background:var(--orange);color:var(--char-deep)}
  .m2 .proof-in{
    max-width:1400px;margin:0 auto;padding:clamp(32px,4vw,56px) clamp(20px,4vw,56px);
    display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:28px 40px;
    font-variant-numeric:tabular-nums;
  }
  .m2 .proof-fig{display:block;font-size:clamp(48px,5vw,80px);line-height:.9;font-weight:800;letter-spacing:-.04em}
  .m2 .proof-unit{font-size:.4em;font-weight:600;letter-spacing:0;margin-left:4px}
  .m2 .proof-label{display:block;margin-top:12px;font-size:15px;font-weight:600;line-height:1.35}

  /* ---------- projects ---------- */
  .m2 .projects{padding-bottom:0}
  .m2 .projects-head{
    display:flex;justify-content:space-between;align-items:end;gap:24px;
    flex-wrap:wrap;margin-bottom:40px;
  }
  .m2 .projects-head h2{font-size:clamp(40px,6vw,96px)}
  .m2 .projects-head p{color:#B5B2AE;font-size:15px;max-width:36ch}
  .m2 .projects-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:12px}
  .m2 .proj{position:relative;display:block;aspect-ratio:4/5;overflow:hidden;color:#fff;background:var(--char)}
  .m2 .proj:hover{color:#fff}
  .m2 .proj img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .6s ease}
  .m2 .proj:hover img{transform:scale(1.04)}
  .m2 .proj-scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(30,29,29,0) 40%,rgba(30,29,29,.92) 100%)}
  .m2 .proj-text{position:absolute;left:28px;right:28px;bottom:28px;display:grid;gap:8px}
  .m2 .proj-kicker{font-size:13px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--orange)}
  .m2 .proj h3{font-size:clamp(32px,3vw,48px);letter-spacing:-.03em;line-height:1}
  .m2 .proj-text p{font-size:15px;color:#E6E3DF;max-width:44ch}
  .m2 .proj-figs{display:flex;gap:16px;font-size:14px;font-weight:600;margin-top:6px}

  /* ---------- systems ---------- */
  .m2 .systems-head{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:24px 64px;align-items:end;margin-bottom:48px;
  }
  .m2 .systems-head h2{font-size:clamp(40px,6vw,96px)}
  .m2 .systems-head p{max-width:52ch;color:#E6E3DF}
  .m2 .sys-list{border-top:1px solid var(--char)}
  .m2 .sys-row{
    display:grid;grid-template-columns:32px 1fr;gap:12px 32px;align-items:center;
    padding:24px 0;border-bottom:1px solid var(--char);
  }
  .m2 .sys-row:hover{color:var(--orange)}
  .m2 .sys-n{font-size:14px;font-weight:600;color:var(--orange);font-variant-numeric:tabular-nums}
  .m2 .sys-name{font-size:clamp(26px,2.6vw,40px);font-weight:700;letter-spacing:-.03em;line-height:1}
  .m2 .sys-desc{font-size:15px;color:#B5B2AE;max-width:56ch;grid-column:2/-1}
  .m2 .sys-thumb{display:none;width:120px;aspect-ratio:3/2;object-fit:cover}
  @media (min-width: 900px){
    .m2 .sys-row{grid-template-columns:48px minmax(200px,320px) 1fr 120px}
    .m2 .sys-desc{grid-column:auto}
    .m2 .sys-thumb{display:block}
  }

  /* ---------- services ---------- */
  .m2 .services{max-width:none;padding:0;background:#F2F0ED;color:var(--char-deep)}
  .m2 .services-in{max-width:1400px;margin:0 auto;padding:clamp(64px,8vw,128px) clamp(20px,4vw,56px)}
  .m2 .services h2{font-size:clamp(40px,6vw,96px);margin-bottom:48px}
  .m2 .svc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px}
  .m2 .svc-card{background:#fff;padding:32px;display:grid;gap:12px;align-content:start}
  .m2 .svc-n{font-size:14px;font-weight:600;color:var(--orange)}
  .m2 .svc-card h3{font-size:26px;font-weight:700;letter-spacing:-.02em;line-height:1.1}
  .m2 .svc-card p{font-size:16px;color:#5A5857}

  /* ---------- about ---------- */
  .m2 .about{position:relative;max-width:none;padding:0;overflow:hidden}
  .m2 .about-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.3}
  .m2 .about-scrim{
    position:absolute;inset:0;
    background:linear-gradient(90deg,rgba(30,29,29,.97) 0%,rgba(30,29,29,.8) 55%,rgba(30,29,29,.5) 100%);
  }
  .m2 .about-in{
    position:relative;max-width:1400px;margin:0 auto;
    padding:clamp(64px,8vw,128px) clamp(20px,4vw,56px);
    display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:40px 64px;
  }
  .m2 .about h2{font-size:clamp(36px,4.6vw,72px);line-height:.98;max-width:14ch}
  .m2 .about-body{display:grid;gap:18px;max-width:58ch;color:#E6E3DF;align-content:end}
  .m2 .about-creds{
    display:flex;flex-wrap:wrap;gap:10px 28px;font-size:14px;font-weight:600;
    color:#B5B2AE;margin-top:8px;
  }

  /* ---------- contact ---------- */
  .m2 .contact{max-width:none;padding:0;background:var(--orange);color:var(--char-deep)}
  .m2 .contact-in{
    max-width:1400px;margin:0 auto;padding:clamp(64px,8vw,128px) clamp(20px,4vw,56px);
    display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:48px 64px;
  }
  .m2 .contact-side{display:grid;gap:28px;align-content:start}
  .m2 .contact h2{font-size:clamp(44px,6vw,96px)}
  .m2 .contact address{font-style:normal;line-height:1.6;font-weight:500}
  .m2 .contact-links{display:grid;gap:2px;font-size:20px;font-weight:700;font-variant-numeric:tabular-nums}
  .m2 .contact-links a{min-height:44px;display:inline-flex;align-items:center}
  .m2 .contact-links a:hover{color:#fff}
  .m2 .contact-alt{font-weight:500;font-size:16px}

  /* ---------- the enquiry form ---------- */
  .m2 .f-form{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
    gap:16px 20px;align-content:start;
  }
  .m2 .f-field{display:grid;gap:6px;font-size:14px;font-weight:600}
  .m2 .f-field-wide{grid-column:1/-1}
  .m2 .f-input,.m2 .f-textarea{
    border:0;border-bottom:2px solid var(--char-deep);background:none;
    padding:10px 0;font-size:17px;font-weight:400;outline:none;
  }
  .m2 .f-input{min-height:46px}
  .m2 .f-textarea{resize:vertical}
  .m2 .f-input::placeholder,.m2 .f-textarea::placeholder{color:rgba(30,29,29,.55)}
  .m2 .f-input:focus,.m2 .f-textarea:focus{border-bottom-color:#fff}
  .m2 .f-submit{
    justify-self:start;grid-column:1/-1;min-height:56px;padding:0 32px;
    background:var(--char-deep);color:#fff;border:0;font-size:16px;font-weight:700;cursor:pointer;
  }
  .m2 .f-submit:hover{background:#fff;color:var(--char-deep)}

</style>
