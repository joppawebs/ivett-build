---
/**
 * Where the enquiry form lands on success.
 *
 * Deliberately in the review chrome rather than any one direction's design: on
 * this site the form is a demonstration that the stack works, and saying so is
 * more useful to the client than a styled thank-you that implies the enquiry
 * reached Ivett.
 */
import Layout from '../layouts/Layout.astro';
import { MOCKUPS, AGENCY } from '../config';
---
<Layout
  path="/success/"
  title="Enquiry sent · Ivett Design and Build mockups"
  description="The enquiry form submitted successfully."
  bodyClass="rv-page"
>
  <main>
    <p class="rv-kicker">Form submitted</p>
    <h1>That went through.</h1>
    <p>
      The form validated, passed the Turnstile check and reached the endpoint — which is the whole
      point of wiring it up in a mockup. On the live site this would arrive in the Ivett inbox
      within a second or two, and the visitor would see a thank-you page in the site's own design
      rather than this one.
    </p>

    <h2>Back to the mockups</h2>
    <div class="rv-actions">
      {MOCKUPS.map((m, i) => (
        <a class:list={['rv-btn', i > 0 && 'rv-btn-ghost']} href={m.path}>{m.n}. {m.name}</a>
      ))}
    </div>
  </main>
  <footer class="rv-foot">
    Prepared by <a href={AGENCY.url}>{AGENCY.name}</a> · not the live ivettbuild.com
  </footer>
</Layout>
