---
import ContactForm from './ContactForm.astro';
---
<section class="contact dark" id="contact">
  <div class="wrap contact-grid">
    <div data-reveal>
      <span class="eyebrow">Get in touch</span>
      <h2>Let's start <span class="acc">a conversation</span>.</h2>
      <ul class="c-points">
        <li>Replace these points in src/components/Contact.astro</li>
        <li>Tell visitors what to expect when they reach out</li>
        <li>Keep it short and reassuring</li>
      </ul>
    </div>
    <ContactForm />
  </div>
</section>
