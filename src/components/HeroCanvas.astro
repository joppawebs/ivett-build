---
// Animated WebGL gradient field behind the hero. Pure raw WebGL (no three.js)
// to stay within the page-speed budget. Progressive enhancement: it only runs
// on desktop, fine-pointer, non-reduced-motion devices with WebGL support -
// everywhere else the .hero CSS gradient remains the background. It also pauses
// when scrolled offscreen or the tab is hidden, so it never burns idle CPU.
---
<canvas class="hero-canvas" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.hero-canvas');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isDesktop = window.matchMedia('(min-width: 881px) and (pointer: fine)').matches;

  function start() {
    if (!canvas || reduce || !isDesktop) return;
    const gl = canvas.getContext('webgl', { antialias: false, alpha: false, depth: false });
    if (!gl) return;

    const vert = `attribute vec2 p; void main(){ gl_Position = vec4(p, 0.0, 1.0); }`;
    const frag = `
      precision mediump float;
      uniform vec2 u_res; uniform float u_time; uniform vec2 u_mouse;
      float hash(vec2 p){ p = fract(p * vec2(123.34, 456.21)); p += dot(p, p + 45.32); return fract(p.x * p.y); }
      float noise(vec2 p){
        vec2 i = floor(p), f = fract(p);
        float a = hash(i), b = hash(i + vec2(1.0, 0.0)), c = hash(i + vec2(0.0, 1.0)), d = hash(i + vec2(1.0, 1.0));
        vec2 u = f * f * (3.0 - 2.0 * f);
        return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
      }
      float fbm(vec2 p){ float v = 0.0, a = 0.5; for(int i = 0; i < 4; i++){ v += a * noise(p); p *= 2.02; a *= 0.5; } return v; }
      void main(){
        vec2 uv = gl_FragCoord.xy / u_res.xy;
        vec2 p = uv * 1.5; p.x *= u_res.x / u_res.y;
        float t = u_time * 0.04;
        vec2 q = vec2(fbm(p + t), fbm(p + vec2(3.2, 1.3) - t));
        float f = fbm(p + q * 1.4 + u_mouse * 0.15);
        vec3 ink = vec3(0.051, 0.106, 0.165);
        vec3 blue = vec3(0.165, 0.298, 0.922);
        vec3 gold = vec3(1.0, 0.678, 0.2);
        float gTR = smoothstep(1.25, 0.0, distance(uv, vec2(0.82, 0.92)));
        float gBL = smoothstep(0.9, 0.0, distance(uv, vec2(0.05, 0.05)));
        vec3 col = ink;
        col += blue * gTR * (0.30 + 0.30 * f);
        col += gold * gBL * (0.08 + 0.10 * f);
        gl_FragColor = vec4(col, 1.0);
      }`;

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, vert));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, frag));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(prog, 'u_res');
    const uTime = gl.getUniformLocation(prog, 'u_time');
    const uMouse = gl.getUniformLocation(prog, 'u_mouse');

    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
    const resize = () => {
      const w = canvas.clientWidth, h = canvas.clientHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform2f(uRes, canvas.width, canvas.height);
    };

    const mouse = { x: 0, y: 0, tx: 0, ty: 0 };
    const hero = canvas.closest('.hero');
    hero?.addEventListener('pointermove', (e) => {
      const r = (hero as HTMLElement).getBoundingClientRect();
      mouse.tx = (e as PointerEvent).clientX / r.width - 0.5;
      mouse.ty = (e as PointerEvent).clientY / r.height - 0.5;
    });

    let raf = 0;
    let running = false;
    const t0 = performance.now();
    const render = (now: number) => {
      mouse.x += (mouse.tx - mouse.x) * 0.05;
      mouse.y += (mouse.ty - mouse.y) * 0.05;
      gl.uniform1f(uTime, (now - t0) / 1000);
      gl.uniform2f(uMouse, mouse.x, mouse.y);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      raf = requestAnimationFrame(render);
    };
    const play = () => { if (!running) { running = true; raf = requestAnimationFrame(render); } };
    const pause = () => { running = false; cancelAnimationFrame(raf); };

    new ResizeObserver(resize).observe(canvas);
    resize();
    canvas.classList.add('is-ready');

    // Only animate while the hero is on screen and the tab is visible.
    new IntersectionObserver((entries) => {
      entries[0].isIntersecting && !document.hidden ? play() : pause();
    }).observe(canvas);
    document.addEventListener('visibilitychange', () => (document.hidden ? pause() : play()));
  }

  // Defer past first paint so the canvas never competes with the LCP.
  if ('requestIdleCallback' in window) {
    (window as any).requestIdleCallback(start, { timeout: 1500 });
  } else {
    window.addEventListener('load', start);
  }
</script>
