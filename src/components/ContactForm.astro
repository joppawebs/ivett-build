---
// Reusable enquiry form. Posts to /api/contact (see src/pages/api/contact.ts),
// which emails via Postmark. Spam handled by a honeypot + Cloudflare Turnstile.
//
// Portable across sites: copy this component, the API route, and the env vars.
// PUBLIC_TURNSTILE_SITE_KEY is exposed to the browser (that's expected for
// Turnstile). The matching secret lives only on the server.
//
// Falls back to Cloudflare's "always passes" test key so local dev works before
// real keys are configured. https://developers.cloudflare.com/turnstile/troubleshooting/testing/
const TURNSTILE_TEST_SITE_KEY = '1x00000000000000000000AA';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? TURNSTILE_TEST_SITE_KEY;
---
<div class="form-card">
  <h3>Start the conversation</h3>
  <p>Two minutes, and there's no commitment at this stage.</p>

  <form id="contact-form" method="POST" action="/api/contact" novalidate>
    <div class="form-status" id="form-status" role="status" aria-live="polite"></div>

    <div class="field-row">
      <div class="field">
        <label for="f-name">Your name</label>
        <input id="f-name" name="name" type="text" autocomplete="name" placeholder="Jane Smith" required>
        <span class="field-error" data-error-for="name"></span>
      </div>
      <div class="field">
        <label for="f-email">Email</label>
        <input id="f-email" name="email" type="email" autocomplete="email" placeholder="jane@business.co.uk" required>
        <span class="field-error" data-error-for="email"></span>
      </div>
    </div>

    <div class="field">
      <label for="f-need">What do you need?</label>
      <select id="f-need" name="need">
        <option>A brand-new website - we don't have one yet</option>
        <option>A redesign of our existing website</option>
        <option>Ongoing care for our current site</option>
        <option>Not sure yet - let's talk</option>
      </select>
    </div>

    <div class="field">
      <label for="f-site">Your current website <span style="font-weight:400;color:var(--ink-mid)">(if you have one)</span></label>
      <input id="f-site" name="website" type="url" autocomplete="url" placeholder="https://">
    </div>

    <div class="field">
      <label for="f-msg">Anything else?</label>
      <textarea id="f-msg" name="message" rows="3" placeholder="A line or two about your business and goals"></textarea>
      <span class="field-error" data-error-for="message"></span>
    </div>

    <!-- Honeypot: real users never see or fill this; bots usually do. -->
    <div class="hp-field" aria-hidden="true">
      <label for="f-company">Company (leave blank)</label>
      <input id="f-company" name="company" type="text" tabindex="-1" autocomplete="off">
    </div>

    <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light" style="margin-bottom:16px"></div>

    <button class="btn btn-primary" type="submit">Send enquiry</button>
    <p class="form-priv">We'll never share your details or add you to a list you didn't ask for.</p>
  </form>
</div>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  import { CONTACT } from '../config';
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  function setStatus(message: string, kind: 'error' | 'success') {
    if (!status) return;
    status.textContent = message;
    status.className = `form-status is-${kind}`;
  }

  function clearFieldErrors() {
    form?.querySelectorAll<HTMLElement>('.field-error').forEach((el) => (el.textContent = ''));
    form?.querySelectorAll('[aria-invalid="true"]').forEach((el) => el.removeAttribute('aria-invalid'));
  }

  function showFieldErrors(errors: Record<string, string>) {
    for (const [field, message] of Object.entries(errors)) {
      const errorEl = form?.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
      if (errorEl) errorEl.textContent = message;
      const input = form?.querySelector(`[name="${field}"]`);
      input?.setAttribute('aria-invalid', 'true');
    }
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearFieldErrors();
    if (status) status.className = 'form-status';

    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    submitBtn?.setAttribute('aria-busy', 'true');
    const originalLabel = submitBtn?.textContent;
    if (submitBtn) submitBtn.textContent = 'Sending…';

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      const data = await response.json().catch(() => ({}));

      if (response.ok && data.ok) {
        // Hand off to the dedicated thank-you page (animated confirmation).
        window.location.assign('/success/');
        return;
      } else if (data.errors) {
        showFieldErrors(data.errors);
        setStatus(data.message ?? 'Please check the highlighted fields and try again.', 'error');
      } else {
        setStatus(data.message ?? `Something went wrong sending your message. Please email ${CONTACT.email} and we’ll pick it up.`, 'error');
      }
    } catch {
      setStatus(`Couldn’t reach the server. Please check your connection or email ${CONTACT.email}.`, 'error');
    } finally {
      submitBtn?.removeAttribute('aria-busy');
      if (submitBtn && originalLabel) submitBtn.textContent = originalLabel;
      // Reset Turnstile so the next attempt gets a fresh token.
      (window as any).turnstile?.reset?.();
    }
  });
</script>
