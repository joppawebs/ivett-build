---
/**
 * The enquiry form — the reusable backbone, shared by all three mockups.
 *
 * Posts to /api/contact (Postmark) with a honeypot + Cloudflare Turnstile in
 * front of it. The markup carries stable `f-*` class names and each mockup
 * styles them from its own page stylesheet, so the same form can look like
 * three different designs without three copies of the logic.
 *
 * PUBLIC_TURNSTILE_SITE_KEY is exposed to the browser (expected for Turnstile);
 * the matching secret stays server-side. With no key configured, this falls
 * back to Cloudflare's "always passes" test key — which is the state this
 * review site ships in, so a submission reaches the endpoint and then reports
 * that email isn't set up. That's intended: it's a mockup.
 */
import { COMPANY } from '../data/ivett';

const TURNSTILE_TEST_SITE_KEY = '1x00000000000000000000AA';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || TURNSTILE_TEST_SITE_KEY;

export interface Props {
  /** Render First name + Last name instead of a single Name field. */
  splitName?: boolean;
  nameLabel?: string;
  messageLabel?: string;
  messagePlaceholder?: string;
  submitLabel?: string;
  /** Turnstile's own widget theme. */
  turnstileTheme?: 'light' | 'dark';
  class?: string;
}

const {
  splitName = false,
  nameLabel = 'Name',
  messageLabel = 'Message',
  messagePlaceholder = '',
  submitLabel = 'Send enquiry',
  turnstileTheme = 'light',
  class: className,
} = Astro.props;
---

<form
  class:list={['f-form', className]}
  method="POST"
  action="/api/contact"
  novalidate
  data-enquiry
  data-fallback-email={COMPANY.salesEmail}
>
  <div class="form-status" data-form-status role="status" aria-live="polite"></div>

  {splitName ? (
    <>
      <label class="f-field">
        <span class="f-label">First name</span>
        <input class="f-input" name="firstName" type="text" autocomplete="given-name" required />
        <span class="field-error" data-error-for="name"></span>
      </label>
      <label class="f-field">
        <span class="f-label">Last name</span>
        <input class="f-input" name="lastName" type="text" autocomplete="family-name" />
      </label>
    </>
  ) : (
    <label class="f-field">
      <span class="f-label">{nameLabel}</span>
      <input class="f-input" name="name" type="text" autocomplete="name" required />
      <span class="field-error" data-error-for="name"></span>
    </label>
  )}

  <label class:list={['f-field', splitName && 'f-field-wide']}>
    <span class="f-label">Email</span>
    <input class="f-input" name="email" type="email" autocomplete="email" required />
    <span class="field-error" data-error-for="email"></span>
  </label>

  <label class="f-field f-field-wide">
    <span class="f-label">{messageLabel}</span>
    <textarea class="f-textarea" name="message" rows="4" placeholder={messagePlaceholder}></textarea>
    <span class="field-error" data-error-for="message"></span>
  </label>

  {/* Honeypot: real visitors never see this; bots fill it in. */}
  <div class="hp-field" aria-hidden="true">
    <label for="f-company">Company (leave blank)</label>
    <input id="f-company" name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="cf-turnstile" data-sitekey={siteKey} data-theme={turnstileTheme}></div>

  <button class="f-submit" type="submit">{submitLabel}</button>
</form>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-enquiry]')) {
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    // Carried on the element rather than imported: pulling in the content
    // module would drag every image import into the browser bundle.
    const fallbackEmail = form.dataset.fallbackEmail ?? '';

    const setStatus = (message: string, kind: 'error' | 'success') => {
      if (!status) return;
      status.textContent = message;
      status.className = `form-status is-${kind}`;
    };

    const clearErrors = () => {
      form.querySelectorAll<HTMLElement>('.field-error').forEach((el) => (el.textContent = ''));
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      if (status) { status.className = 'form-status'; status.textContent = ''; }
    };

    const showErrors = (errors: Record<string, string>) => {
      for (const [field, message] of Object.entries(errors)) {
        const target = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
        if (target) target.textContent = message;
        // The split-name variant reports against "name"; point at the first input.
        const input =
          form.querySelector(`[name="${field}"]`) ??
          (field === 'name' ? form.querySelector('[name="firstName"]') : null);
        input?.setAttribute('aria-invalid', 'true');
      }
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();

      const submit = form.querySelector<HTMLButtonElement>('[type="submit"]');
      const label = submit?.textContent;
      submit?.setAttribute('aria-busy', 'true');
      if (submit) submit.textContent = 'Sending…';

      const body = new FormData(form);
      // The endpoint takes one `name`; the split variant sends two fields.
      if (!body.get('name')) {
        const first = (body.get('firstName') ?? '').toString().trim();
        const last = (body.get('lastName') ?? '').toString().trim();
        body.set('name', [first, last].filter(Boolean).join(' '));
      }

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body,
        });
        const data = (await response.json().catch(() => ({}))) as {
          ok?: boolean;
          message?: string;
          errors?: Record<string, string>;
        };

        if (response.ok && data.ok) {
          window.location.assign('/success/');
          return;
        }
        if (data.errors) {
          showErrors(data.errors);
          setStatus(data.message ?? 'Please check the highlighted fields and try again.', 'error');
        } else {
          setStatus(
            data.message ?? `Something went wrong. Please email ${fallbackEmail}.`,
            'error'
          );
        }
      } catch {
        setStatus(
          `Couldn’t reach the server. Please check your connection or email ${fallbackEmail}.`,
          'error'
        );
      } finally {
        submit?.removeAttribute('aria-busy');
        if (submit && label) submit.textContent = label;
        // Fresh Turnstile token for the next attempt.
        (window as unknown as { turnstile?: { reset?: () => void } }).turnstile?.reset?.();
      }
    });
  }
</script>
