---
// Header is driven by src/config.ts. Nav links are root-relative so they work
// from any page, not just the homepage.
import { SITE, NAV, CTA } from '../config';
---
<header>
  <div class="wrap nav">
    <a class="logo" href="/">{SITE.name}</a>
    <ul class="nav-links">
      {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
    <a class="btn btn-gold" href={CTA.href} data-magnetic>{CTA.label}</a>
  </div>
</header>
