# Environment variables
# Copy this file to `.dev.vars` for local `astro dev`, and set the same keys as
# secrets in Cloudflare (and GitHub Actions) for production. See SETUP.md.

# --- Postmark (transactional email) ---
# Server API token from Postmark > Servers > [your server] > API Tokens
POSTMARK_SERVER_TOKEN=

# Where enquiry emails are delivered
CONTACT_TO_EMAIL=you@example.com

# Must be a verified Sender Signature (or verified domain) in Postmark
CONTACT_FROM_EMAIL=enquiries@example.com

# --- Cloudflare Turnstile (spam protection) ---
# From Cloudflare dashboard > Turnstile > [your widget]
# Public key is exposed to the browser; secret key stays server-side.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
